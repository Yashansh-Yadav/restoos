# RestoOS environment (plan §13). Copy to `.env` in the repo root for local development:
#   cp .env.example .env
# Both apps validate this at startup (apps/api/src/env.ts, apps/web/src/env.ts) and refuse to
# start with a clear list of what is missing or invalid. Empty values (KEY=) count as unset.
# REQUIRED = needed today. Others are optional until the milestone in brackets makes them required.

# ─── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── apps/api (Fastify backend — holds every secret) ──────────────────────
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace
APP_URL=http://localhost:3000  # REQUIRED — public URL of the web app (links in messages, OAuth redirects)

# Local Docker (pnpm infra:up) — non-default host ports 5434 / 6380
DATABASE_URL=postgresql://restoos:restoos@localhost:5434/restoos  # REQUIRED
REDIS_URL=redis://localhost:6380                                # REQUIRED
# Integration tests only — a separate database, created and migrated automatically by the tests.
# Must differ from DATABASE_URL and contain "test" (safety check).
TEST_DATABASE_URL=postgresql://restoos:restoos@localhost:5434/restoos_test

# Owner auth: Google OAuth 2.0 + mobile OTP via Better Auth [M1-T1]
BETTER_AUTH_SECRET=            # ≥32 random chars, e.g. `openssl rand -base64 48`
GOOGLE_CLIENT_ID=              # Google Cloud OAuth 2.0 client (web)
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER=console           # console (prints OTPs in dev) | msg91
OTP_API_KEY=

# Web Push [M8-T1]
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto:you@example.com or https://…

# File storage — AWS S3 Mumbai [M2-T1]
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Razorpay — UPI auto-confirm [M7-T4] and SaaS subscriptions [M12]
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp bills [M7-T7]
MESSAGING_PROVIDER=console     # console (prints messages in dev) | <bsp>
MESSAGING_API_KEY=

# Error tracking [M0-T6]
SENTRY_DSN=

# Our own GST invoices to restaurants [M12-T9]
PLATFORM_GSTIN=
PLATFORM_LEGAL_NAME=

# ─── apps/web (Next.js frontend — no secrets) ─────────────────────────────
API_INTERNAL_URL=http://localhost:4000   # where Next reaches apps/api server-side; REQUIRED in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
