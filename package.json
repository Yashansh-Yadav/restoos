{
  "name": "restoos",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test --concurrency=4",
    "test:e2e": "pnpm --filter @restoos/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @restoos/db generate",
    "db:migrate": "pnpm --filter @restoos/db migrate",
    "db:migrate:deploy": "pnpm --filter @restoos/db migrate:deploy",
    "db:reset": "pnpm --filter @restoos/db reset",
    "db:seed": "pnpm --filter @restoos/db seed",
    "db:studio": "pnpm --filter @restoos/db studio"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10"
  }
}
